rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own data
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Transactions can be read and written by authenticated users.
    // TODO: Refine these rules for more granular control, e.g.,
    // only allowing writes for valid transactions between two users.
    match /transactions/{transactionId} {
      allow read, write: if request.auth.uid != null;
    }

    // Allow read-only access to some public data, if applicable
    // match /publicData/{documentId} {
    //   allow read: if true;
    // }
  }
}
